# Payment Gateway Configuration

PORT=8080

# PostgreSQL — shared with the NestJS backend (read/write, no DDL)
DATABASE_URL=jdbc:postgresql://localhost:5432/console_shop?user=console_shop_backend&password=yourpassword

# Omise payment keys
OMISE_SECRET_KEY=skey_test_...
OMISE_PUBLIC_KEY=pkey_test_...
OMISE_WEBHOOK_SECRET=your_webhook_secret

# Return URL after 3DS / PromptPay redirect
OMISE_RETURN_URL=https://yourdomain.com/payment-success

# Internal secret — must match API Gateway INTERNAL_SECRET
INTERNAL_SECRET=internal-secret-change-me-in-production
